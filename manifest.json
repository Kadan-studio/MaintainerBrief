{
  "manifest_version": 3,
  "name": "MaintainerBrief",
  "version": "1.0.0",
  "description": "Copy structured GitHub issue and pull request context for AI coding assistants.",
  "action": {
    "default_title": "MaintainerBrief",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "clipboardWrite"]
}
